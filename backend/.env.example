# Copy to backend/.env and fill in the values. Never commit real keys.
# Every name matches a field in app/config.py. Local defaults match infra/docker-compose.yml.

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=info

# LLM (Groq via LiteLLM) - required
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=groq/llama-3.3-70b-versatile
GROQ_MODEL_FAST=groq/llama-3.1-8b-instant

# Database
DATABASE_URL=postgresql+asyncpg://ise:ise_dev_password@localhost:5432/ise_db

# Redis (set REDIS_URL to use a hosted Redis such as Upstash; it overrides host/port)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=

# Qdrant (set QDRANT_URL + QDRANT_API_KEY for Qdrant Cloud; it overrides host/port)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_URL=

# MinIO (file uploads)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ise-uploads
MINIO_SECURE=false

# Clerk (auth)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Langfuse (tracing; local UI at http://localhost:3001)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_MESSAGES_PER_MINUTE=10

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=support@ise.local
